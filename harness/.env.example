# Salin menjadi .env lalu isi. Selama LLM_BASE_URL / LLM_MODEL kosong, AI tidak dipakai:
# UI tetap bisa dipakai untuk review dan edit manual.

# Alamat API model lokal yang kompatibel OpenAI, contoh:
#   Ollama     : http://127.0.0.1:11434/v1
#   LM Studio  : http://127.0.0.1:1234/v1
#   llama.cpp  : http://127.0.0.1:8080/v1
LLM_BASE_URL=https://router.bynara.id/v1
# Nama model di server lokal tersebut, mis. qwen2.5:7b-instruct
LLM_MODEL=agnes-3-flash
# Biasanya kosong untuk model lokal.
LLM_API_KEY=

# Batas waktu satu panggilan AI (detik). Model lokal bisa lambat.
LLM_TIMEOUT=180
# Berapa kali AI diminta mengulang bila hasilnya tidak lolos pemeriksaan.
LLM_MAX_PERCOBAAN=3

# Folder penyimpanan pekerjaan dan cache (bawaan: harness/data).
HARNESS_DATA_DIR=
